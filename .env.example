# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./beacon.db

# Keycloak / OIDC
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=beacon
KEYCLOAK_CLIENT_ID=beacon-studio
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
OIDC_ISSUER=http://127.0.0.1:8080/realms/beacon
OIDC_AUDIENCE=beacon-studio

# LLM Providers (optional, opt-in)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security
SECRET_KEY=change-me-in-production
CSRF_SECRET_KEY=change-me-in-production

# Demo mode (explicit opt-in, refuses in production)
DEMO_MODE=false